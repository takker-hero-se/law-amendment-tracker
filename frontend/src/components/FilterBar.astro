---
/**
 * カテゴリ・影響度・施行状態・全文検索のクライアント側フィルタと、ページ送り。
 * `.amendment-card` / `.amendment-row` の data-* 属性を読んで表示/非表示を切り替える。
 * ページ側に `<Pager />`（`[data-pager]`）があれば、絞り込み結果を pageSize 件ずつに分けて表示する。
 */
import { Search, Filter } from "lucide-astro";
import { CATEGORIES } from "../content.config";
import { slugByCategory } from "../lib/amendments";

interface Props {
  fixedCategory?: string;
  total: number;
  /** 1 ページあたりの件数。0 ならページ分割しない。 */
  pageSize?: number;
}
const { fixedCategory, total, pageSize = 50 } = Astro.props;
---

<section class="rounded-lg border border-line bg-white p-3 shadow-sm" id="filter-bar" data-page-size={pageSize}>
  <div class="flex flex-wrap items-center gap-2">
    <label class="relative flex-1 basis-60">
      <Search size={16} class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-muted" />
      <input id="q" type="search" placeholder="法令名・改正法で検索" class="w-full rounded-md border border-line py-1.5 pl-8 pr-3 text-sm focus:border-cyan-600 focus:outline-none" autocomplete="off" />
    </label>
    <select id="impact" class="rounded-md border border-line px-2 py-1.5 text-sm">
      <option value="">影響度: すべて</option>
      <option value="High">影響 大</option>
      <option value="Medium">影響 中</option>
      <option value="Low">影響 小</option>
    </select>
    <select id="status" class="rounded-md border border-line px-2 py-1.5 text-sm">
      <option value="">施行状態: すべて</option>
      <option value="UnEnforced">未施行</option>
      <option value="CurrentEnforced">施行済</option>
      <option value="PreviousEnforced">過去の版</option>
      <option value="Repeal">廃止</option>
    </select>
    <span class="ml-auto flex items-center gap-1 text-xs text-muted"><Filter size={14} />該当 <b id="shown" class="text-ink">{total}</b> / {total} 件</span>
  </div>
  {
    !fixedCategory && (
      <div class="mt-2 flex flex-wrap gap-1.5" id="cats">
        <button type="button" data-cat="" class="cat-btn is-on rounded-md border border-line px-2.5 py-1 text-xs">
          すべて
        </button>
        {CATEGORIES.map((c) => (
          <button type="button" data-cat={slugByCategory[c]} class="cat-btn rounded-md border border-line px-2.5 py-1 text-xs">
            {c}
          </button>
        ))}
      </div>
    )
  }
</section>

<style>
  .cat-btn.is-on {
    background: var(--color-navy-900);
    color: #fff;
    border-color: var(--color-navy-900);
  }
</style>

<script>
  const bar = document.getElementById("filter-bar");
  const q = document.getElementById("q") as HTMLInputElement | null;
  const impact = document.getElementById("impact") as HTMLSelectElement | null;
  const status = document.getElementById("status") as HTMLSelectElement | null;
  const shown = document.getElementById("shown");
  const items = Array.from(document.querySelectorAll<HTMLElement>(".amendment-card, .amendment-row"));
  const pager = document.querySelector<HTMLElement>("[data-pager]");
  const pageSize = Number(bar?.dataset.pageSize ?? "0") || 0;
  let cat = "";
  let page = 0;

  function matches(item: HTMLElement, needle: string): boolean {
    return (
      (!cat || (item.dataset.categories ?? "").split(" ").includes(cat)) &&
      (!impact?.value || item.dataset.impact === impact.value) &&
      (!status?.value || item.dataset.status === status.value) &&
      (!needle || (item.dataset.search ?? "").includes(needle))
    );
  }

  function apply(resetPage = true) {
    if (resetPage) page = 0;
    const needle = (q?.value ?? "").trim().toLowerCase();
    const ok = items.filter((item) => matches(item, needle));
    const pages = pageSize > 0 ? Math.max(1, Math.ceil(ok.length / pageSize)) : 1;
    if (page >= pages) page = pages - 1;
    const onPage = new Set(pageSize > 0 ? ok.slice(page * pageSize, (page + 1) * pageSize) : ok);
    for (const item of items) item.hidden = !onPage.has(item);
    if (shown) shown.textContent = String(ok.length);
    document.querySelectorAll<HTMLElement>("[data-empty]").forEach((el) => (el.hidden = ok.length > 0));
    if (pager) {
      pager.hidden = pages <= 1;
      const first = page * pageSize + 1;
      const last = Math.min(ok.length, (page + 1) * pageSize);
      pager.querySelector("[data-page]")!.textContent = `${page + 1} / ${pages} ページ（${first}〜${last} 件目）`;
      (pager.querySelector("[data-prev]") as HTMLButtonElement).disabled = page === 0;
      (pager.querySelector("[data-next]") as HTMLButtonElement).disabled = page >= pages - 1;
    }
  }

  function go(delta: number) {
    page += delta;
    apply(false);
    document.getElementById("list")?.scrollIntoView({ block: "start", behavior: "smooth" });
  }

  q?.addEventListener("input", () => apply());
  impact?.addEventListener("change", () => apply());
  status?.addEventListener("change", () => apply());
  pager?.querySelector("[data-prev]")?.addEventListener("click", () => go(-1));
  pager?.querySelector("[data-next]")?.addEventListener("click", () => go(1));
  document.querySelectorAll<HTMLButtonElement>(".cat-btn").forEach((btn) =>
    btn.addEventListener("click", () => {
      cat = btn.dataset.cat ?? "";
      document.querySelectorAll(".cat-btn").forEach((b) => b.classList.toggle("is-on", b === btn));
      apply();
    }),
  );
  const params = new URLSearchParams(location.search);
  if (params.get("q") && q) q.value = params.get("q") ?? "";
  if (params.get("impact") && impact) impact.value = params.get("impact") ?? "";
  if (params.get("status") && status) status.value = params.get("status") ?? "";
  apply();
</script>
