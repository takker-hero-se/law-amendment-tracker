# LLM provider: anthropic | gemini | template (no LLM, deterministic) 
LAWTRACK_LLM_PROVIDER=template
ANTHROPIC_API_KEY=
LAWTRACK_ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
LAWTRACK_GEMINI_MODEL=gemini-2.5-flash

# Detection source: egov (snapshot + watchlist) | git (local mirror clone)
LAWTRACK_SOURCE=egov
LAWTRACK_EGOV_BASE_URL=https://laws.e-gov.go.jp/api/2
# law types scanned by the snapshot source (comma separated e-Gov law_type values)
LAWTRACK_LAW_TYPES=Act
# optional: restrict the snapshot scan to e-Gov category codes (e.g. 015,020,013)
LAWTRACK_CATEGORY_CODES=
LAWTRACK_WATCHLIST=data/watchlist.json
LAWTRACK_GIT_MIRROR_DIR=
LAWTRACK_MAX_EVENTS_PER_RUN=30
LAWTRACK_REQUEST_INTERVAL_SEC=0.3
LAWTRACK_HTTP_TIMEOUT_SEC=60

# noise filter
LAWTRACK_NOISE_MIN_CHANGED_CHARS=40
LAWTRACK_NOISE_MIN_CHANGED_LINES=2

# output
LAWTRACK_CONTENT_DIR=frontend/src/content/amendments
LAWTRACK_STATE_FILE=data/state.json
LAWTRACK_LLM_INPUT_MAX_CHARS=24000
