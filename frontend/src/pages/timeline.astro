---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ImpactBadge from "../components/ImpactBadge.astro";
import CategoryChip from "../components/CategoryChip.astro";
import { amendmentPath, byEnforcementAsc, formatDate } from "../lib/amendments";

const all = (await getCollection("amendments")).sort(byEnforcementAsc);
const today = new Date().toISOString().slice(0, 10);
const future = all.filter((e) => e.data.enforcement_date && e.data.enforcement_date >= today);
const past = all.filter((e) => e.data.enforcement_date && e.data.enforcement_date < today).reverse();
const unknown = all.filter((e) => !e.data.enforcement_date);

function groupByMonth(list: typeof all) {
  const map = new Map<string, typeof all>();
  for (const e of list) {
    const key = (e.data.enforcement_date ?? "").slice(0, 7);
    map.set(key, [...(map.get(key) ?? []), e]);
  }
  return [...map.entries()];
}
const futureGroups = groupByMonth(future);
const pastGroups = groupByMonth(past);
---

<Base title="施行日タイムライン" description="これから施行される法改正を施行日順に並べた一覧。">
  <h1 class="text-2xl font-bold">施行日タイムライン</h1>
  <p class="mt-1 text-sm text-muted">公布順ではなく、施行される順に並べる。今日（{formatDate(today)}）以降に施行される改正を先頭に置く。</p>

  <section class="mt-6">
    <h2 class="text-lg font-bold text-cyan-600">これから施行（{future.length} 件）</h2>
    {future.length === 0 && <p class="mt-2 text-sm text-muted">未施行の改正は収録されていない。</p>}
    <div class="mt-3 space-y-6">
      {
        futureGroups.map(([month, items]) => (
          <div class="relative border-l-2 border-cyan-600 pl-5">
            <span class="absolute -left-[9px] top-0 h-4 w-4 rounded-full border-2 border-white bg-cyan-600" />
            <h3 class="text-sm font-bold">{month.replace("-", "年")}月</h3>
            <ul class="mt-2 space-y-2">
              {items.map((e) => (
                <li class="rounded-lg border border-line bg-white p-3 text-sm">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-mono text-xs font-semibold text-cyan-600">{e.data.enforcement_date}</span>
                    <ImpactBadge level={e.data.impact_level} />
                    {e.data.categories.map((c) => (
                      <CategoryChip category={c} />
                    ))}
                  </div>
                  <a href={amendmentPath(e)} class="mt-1 block font-bold hover:text-cyan-600">
                    {e.data.title}
                  </a>
                  <p class="mt-0.5 text-xs text-muted">{e.data.amending_law_title ?? e.data.amendment_type} · 公布 {formatDate(e.data.promulgation_date)}</p>
                  <p class="mt-1 text-sm">{e.data.summary_points[0]}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  {
    unknown.length > 0 && (
      <section class="mt-10">
        <h2 class="text-lg font-bold">施行日が未定・政令委任（{unknown.length} 件）</h2>
        <ul class="mt-3 grid gap-2 md:grid-cols-2">
          {unknown.map((e) => (
            <li class="rounded-lg border border-line bg-white p-3 text-sm">
              <a href={amendmentPath(e)} class="font-bold hover:text-cyan-600">{e.data.title}</a>
              <p class="mt-0.5 text-xs text-muted">{e.data.enforcement_note}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mt-10">
    <h2 class="text-lg font-bold text-muted">施行済（{past.length} 件）</h2>
    <div class="mt-3 space-y-5">
      {
        pastGroups.map(([month, items]) => (
          <div class="relative border-l-2 border-line pl-5">
            <span class="absolute -left-[9px] top-0 h-4 w-4 rounded-full border-2 border-white bg-line" />
            <h3 class="text-sm font-bold text-muted">{month.replace("-", "年")}月</h3>
            <ul class="mt-2 space-y-1.5">
              {items.map((e) => (
                <li class="flex flex-wrap items-center gap-2 text-sm">
                  <span class="font-mono text-xs text-muted">{e.data.enforcement_date}</span>
                  <ImpactBadge level={e.data.impact_level} />
                  <a href={amendmentPath(e)} class="font-medium hover:text-cyan-600">{e.data.title}</a>
                  <span class="text-xs text-muted">{e.data.amending_law_title ?? e.data.amendment_type}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>
