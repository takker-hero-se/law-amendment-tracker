---
import { IMPACT_LABEL } from "../lib/amendments";

interface Props {
  level: "High" | "Medium" | "Low";
  size?: "sm" | "md";
}
const { level, size = "sm" } = Astro.props;
const color = { High: "bg-impact-high", Medium: "bg-impact-medium", Low: "bg-impact-low" }[level];
---

<span class:list={["inline-flex items-center gap-1 rounded-full font-semibold text-white", color, size === "sm" ? "px-2 py-0.5 text-[11px]" : "px-3 py-1 text-xs"]} title={`実務影響度: ${level}`}>
  <span class="h-1.5 w-1.5 rounded-full bg-white/80"></span>
  {IMPACT_LABEL[level]}
</span>
