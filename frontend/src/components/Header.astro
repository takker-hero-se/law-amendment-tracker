---
import { Scale, Network, CalendarClock, Rss, Github } from "lucide-astro";
import { SITE_NAME } from "../lib/amendments";

interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "新着・重要", icon: Scale },
  { href: "/timeline/", label: "施行日タイムライン", icon: CalendarClock },
  { href: "/map/", label: "法令変遷図", icon: Network },
];
const active = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="bg-navy-900 text-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <span class="grid h-8 w-8 place-items-center rounded-md bg-cyan-500 text-navy-950"><Scale size={18} /></span>
      <span>{SITE_NAME}</span>
      <span class="hidden text-xs font-normal text-slate-300 sm:inline">Law Amendment Tracker</span>
    </a>
    <nav class="flex flex-wrap items-center gap-1 text-sm">
      {
        nav.map(({ href, label, icon: Icon }) => (
          <a
            href={href}
            class:list={["flex items-center gap-1.5 rounded-md px-3 py-1.5 transition", active(href) ? "bg-cyan-600 text-white" : "text-slate-200 hover:bg-navy-700 hover:text-white"]}
            aria-current={active(href) ? "page" : undefined}
          >
            <Icon size={16} />
            {label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-2 text-slate-300">
      <a href="/rss.xml" class="rounded-md p-1.5 hover:bg-navy-700 hover:text-white" title="RSS" aria-label="RSS"><Rss size={18} /></a>
      <a href="https://github.com/" rel="noopener" class="rounded-md p-1.5 hover:bg-navy-700 hover:text-white" title="ソースコード" aria-label="GitHub"><Github size={18} /></a>
    </div>
  </div>
  {dark ? null : <div class="h-1 bg-gradient-to-r from-cyan-600 via-cyan-500 to-navy-700" />}
</header>
