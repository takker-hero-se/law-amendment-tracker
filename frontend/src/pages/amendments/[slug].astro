---
import { getCollection, render } from "astro:content";
import { ChevronLeft, ExternalLink, CalendarDays, Clock, FileDiff, GitBranch, Tag, BookOpen } from "lucide-astro";
import Base from "../../layouts/Base.astro";
import ImpactBadge from "../../components/ImpactBadge.astro";
import CategoryChip from "../../components/CategoryChip.astro";
import { amendmentPath, formatDate, LAW_TYPE_LABEL, STATUS_LABEL, type Amendment } from "../../lib/amendments";

export async function getStaticPaths() {
  const entries = await getCollection("amendments");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, siblings: entries.filter((e) => e.data.law_id === entry.data.law_id && e.id !== entry.id) } }));
}

interface Props {
  entry: Amendment;
  siblings: Amendment[];
}
const { entry, siblings } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const lineage = [...siblings, entry].sort((a, b) => a.data.promulgation_date.localeCompare(b.data.promulgation_date) || (a.data.enforcement_date ?? "").localeCompare(b.data.enforcement_date ?? ""));
const description = d.summary_points.join(" ");
---

<Base title={`${d.title}（${d.amendment_type}）`} description={description}>
  <a href="/" class="inline-flex items-center gap-1 text-sm text-muted hover:text-cyan-600"><ChevronLeft size={16} />一覧へ</a>
  <article class="mt-3">
    <header class="rounded-xl border border-line bg-white p-5">
      <div class="flex flex-wrap items-center gap-2">
        <ImpactBadge level={d.impact_level} size="md" />
        <span class="rounded-md bg-navy-900 px-2 py-0.5 text-xs font-semibold text-white">{d.amendment_type}</span>
        <span class="rounded-md border border-line px-2 py-0.5 text-xs text-muted">{LAW_TYPE_LABEL[d.law_type]}</span>
        <span class="rounded-md border border-line px-2 py-0.5 text-xs text-muted">{STATUS_LABEL[d.enforcement_status]}</span>
      </div>
      <h1 class="mt-3 text-2xl font-bold leading-snug">{d.title}</h1>
      <p class="mt-1 text-sm text-muted">{d.law_num}{d.egov_category ? ` · e-Gov 分類: ${d.egov_category}` : ""}</p>
      {d.amending_law_title && <p class="mt-2 text-sm"><span class="text-muted">改正法令: </span>{d.amending_law_title}{d.amending_law_num ? `（${d.amending_law_num}）` : ""}</p>}

      <h2 class="mt-5 text-sm font-bold text-navy-900">3 行要旨</h2>
      <ol class="mt-2 space-y-1.5 text-[15px] leading-relaxed">
        {d.summary_points.map((p, i) => (<li class="flex gap-2"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-cyan-600 text-[11px] font-bold text-white">{i + 1}</span><span>{p}</span></li>))}
      </ol>

      <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-lg bg-paper p-3"><dt class="flex items-center gap-1 text-xs text-muted"><CalendarDays size={14} />公布日</dt><dd class="mt-1 font-semibold">{formatDate(d.promulgation_date)}</dd></div>
        <div class="rounded-lg bg-paper p-3"><dt class="flex items-center gap-1 text-xs text-muted"><Clock size={14} />施行日</dt><dd class="mt-1 font-semibold">{d.enforcement_date ? formatDate(d.enforcement_date) : "未定"}</dd>{d.enforcement_note !== d.enforcement_date && <dd class="mt-0.5 text-xs text-muted">{d.enforcement_note}</dd>}</div>
        <div class="rounded-lg bg-paper p-3"><dt class="flex items-center gap-1 text-xs text-muted"><Tag size={14} />分野</dt><dd class="mt-1 flex flex-wrap gap-1">{d.categories.map((c) => <CategoryChip category={c} />)}</dd></div>
        <div class="rounded-lg bg-paper p-3"><dt class="flex items-center gap-1 text-xs text-muted"><FileDiff size={14} />条文差分</dt><dd class="mt-1 font-mono text-sm">+{d.stats.added_lines} / -{d.stats.removed_lines} 行 · {d.stats.changed_chars.toLocaleString()} 字</dd></div>
      </dl>
      <p class="mt-3 text-sm"><span class="text-muted">主な対象: </span>{d.target_audience.join("、")}</p>
      <div class="mt-4 flex flex-wrap gap-2 text-xs">
        <a href={d.egov_url} rel="noopener" target="_blank" class="inline-flex items-center gap-1 rounded-md border border-line bg-white px-3 py-1.5 hover:border-cyan-600"><ExternalLink size={14} />e-Gov 法令検索で原文を見る</a>
        <a href={`https://laws.e-gov.go.jp/law/${d.law_id}/${d.revision_id.split("_")[1]}_${d.revision_id.split("_")[2]}`} rel="noopener" target="_blank" class="inline-flex items-center gap-1 rounded-md border border-line bg-white px-3 py-1.5 hover:border-cyan-600"><BookOpen size={14} />この履歴の版（{d.revision_id}）</a>
        <a href={`/map/?law=${d.law_id}`} class="inline-flex items-center gap-1 rounded-md border border-line bg-white px-3 py-1.5 hover:border-cyan-600"><GitBranch size={14} />変遷図で見る</a>
      </div>
    </header>

    {!d.text_available && <p class="mt-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">e-Gov はこの履歴の本文ファイルを提供していない。条文差分は未取得で、公布日・施行日・改正法令名のみ掲載している。</p>}
    <div class="prose-law mt-6 rounded-xl border border-line bg-white p-5">
      <Content />
    </div>

    {
      lineage.length > 1 && (
        <section class="mt-6 rounded-xl border border-line bg-white p-5">
          <h2 class="flex items-center gap-2 text-base font-bold"><GitBranch size={16} />この法令の改正系譜</h2>
          <ol class="relative mt-3 ml-2 border-l-2 border-line pl-5">
            {lineage.map((e) => (
              <li class="relative mb-3">
                <span class:list={["absolute -left-[27px] top-1.5 h-3 w-3 rounded-full border-2 border-white", e.id === entry.id ? "bg-cyan-600 ring-2 ring-cyan-600/30" : "bg-line"]} />
                <div class="text-xs text-muted">公布 {formatDate(e.data.promulgation_date)} · 施行 {e.data.enforcement_date ? formatDate(e.data.enforcement_date) : "未定"} · {STATUS_LABEL[e.data.enforcement_status]}</div>
                {e.id === entry.id ? <span class="font-bold">{e.data.amending_law_title ?? e.data.amendment_type}（このページ）</span> : <a href={amendmentPath(e)} class="font-medium hover:text-cyan-600">{e.data.amending_law_title ?? e.data.amendment_type}</a>}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <p class="mt-6 text-xs text-muted">生成: {d.generated_at}（provider: {d.provider}, source: {d.source}）。要旨・影響度・分野は機械生成であり、法的助言ではない。</p>
  </article>
</Base>

<script>
  // 差分ブロックの行頭記号で着色する（Shiki の diff 文法に依存しない）
  for (const pre of document.querySelectorAll<HTMLElement>(".prose-law pre")) {
    const code = pre.querySelector("code");
    if (!code || !/diff/i.test(pre.className + " " + (pre.dataset.language ?? ""))) continue;
    for (const line of code.querySelectorAll<HTMLElement>(".line")) {
      const t = line.textContent ?? "";
      if (t.startsWith("+++") || t.startsWith("---") || t.startsWith("@@")) line.classList.add("diff-meta");
      else if (t.startsWith("+")) line.classList.add("diff-add");
      else if (t.startsWith("-")) line.classList.add("diff-del");
    }
  }
</script>
